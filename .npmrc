; audit-level=critical (default: null — no threshold)
; Fails `npm audit` and install-time audit only on critical severity
; vulnerabilities. Avoids blocking on moderate/high findings while still
; hard-failing on critical exposure.
audit-level=critical

; save-exact=true (default: false — saves with ^ range)
; Pins exact versions when adding packages via `npm install <pkg>`. The
; lockfiles are the primary pinning mechanism; exact saves keep package.json
; honest too. `bun add` uses its own versioning and ignores this setting.
save-exact=true

; min-release-age=2 (default: null — no restriction), unit: days
; Rejects packages published within the last 48 hours at resolution time.
; Guards against "fastest-finger" supply-chain attacks: a compromised maintainer
; account or typosquatting package gets published and pulled in by victims
; within minutes; a 2-day hold gives the security community and npm's malware
; scanning time to detect and yank it. `npm ci` installs strictly from the
; lockfile without re-resolving, so already-pinned versions are never blocked.
; The bun side of this guard lives in bunfig.toml (install.minimumReleaseAge,
; in seconds) — keep the two values in sync.
min-release-age=2

; prefer-dedupe=true (default: false)
; Deduplicates packages in the dependency tree during installs, preferring a
; single shared copy over multiple versions. Reduces bundle size and avoids
; subtle bugs from duplicate singletons.
prefer-dedupe=true

; fetch-retries=3 (default: 2)
; Adds one extra retry on transient registry failures. Reduces flaky install
; failures in CI and on less stable networks.
fetch-retries=3

; fund=false (default: true)
; Suppresses post-install funding messages.
fund=false

; allow-git=none (default in npm <12: all; becomes none in npm v12)
; Blocks git dependencies (direct or transitive). A git dep's .npmrc can
; override the git executable path for arbitrary code execution at install —
; even under --ignore-scripts. This template resolves only from the registry,
; so enforcing none now surfaces any accidental git dep loudly instead of at
; the v12 cutover. npm-only; bun is unaffected.
allow-git=none

; allow-remote=none (default in npm <12: all; becomes none in npm v12)
; Blocks dependencies fetched from remote URLs (e.g. https tarballs), direct
; or transitive. Does not affect normal registry resolution. npm-only.
allow-remote=none
