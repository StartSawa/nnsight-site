---
// Renders a post body split by splitSegments: Markdown through renderRichText,
// code in the dark editor with a copy button, figures with captions, and
// collapsible details (recursing into their contents). Every block fills the
// same single column, so text, code, figures and notes share both edges.
import { renderRichText } from "../../../../ploy.ploydb-richtext.mjs";
import { BlogCodeLines, BlogCopyButton } from "./blog-code";
import { PostViz } from "./post-viz";
import { figureCaption, type Segment } from "./segments";
import { CODE_BG, CODE_FRAME, COLUMN, GLASS_BG, GLASS_SURFACE, PROSE, wrapTables } from "./blog-styles";

const md = (s: string) => wrapTables(renderRichText(s));


interface Props {
  segments: Segment[];
  nested?: boolean;
}

const { segments, nested = false } = Astro.props;

---

{
  segments.map((seg) => {
    if (seg.type === "md") {
      return <div class:list={[PROSE, nested && "prose-p:my-3"]} set:html={md(seg.md)} />;
    }
    if (seg.type === "code") {
      if (!seg.code.trim()) return null;
      return (
        <div
          class:list={[
            CODE_FRAME,
            COLUMN,
          ]}
          style={CODE_BG}
        >
          <div class="flex h-10 items-center justify-end border-b border-white/[0.06] pr-1">
            <BlogCopyButton client:visible value={seg.code} />
          </div>
          <BlogCodeLines code={seg.code} lang={seg.lang} />
        </div>
      );
    }
    if (seg.type === "figure") {
      const caption = figureCaption(seg.alt);
      return (
        <figure class:list={["not-prose my-10 md:my-12", COLUMN]}>
          <a
            href={seg.src}
            target="_blank"
            rel="noopener"
            class:list={["block overflow-hidden rounded-[6px] p-2.5 transition-transform duration-300 hover:-translate-y-0.5 md:p-4", GLASS_SURFACE]}
            style={GLASS_BG}
          >
            <img src={seg.src} alt={seg.alt} loading="lazy" decoding="async" class="mx-auto h-auto w-full rounded-[6px] bg-white" />
          </a>
          {caption && (
            <figcaption class="mx-auto mt-3.5 max-w-[38rem] text-center text-[0.875rem] italic leading-[1.55] text-ploy-text-secondary">{caption}</figcaption>
          )}
        </figure>
      );
    }
    if (seg.type === "viz") {
      return (
        <div class:list={["not-prose my-10 md:my-12", COLUMN]}>
          <PostViz client:visible name={seg.name} />
        </div>
      );
    }
    if (seg.type === "note") {
      return (
        <aside class:list={["not-prose my-8 rounded-[6px] px-5 py-4 md:px-6 md:py-5", GLASS_SURFACE, COLUMN]} style={GLASS_BG}>
          {seg.title && <p class="text-[0.9375rem] font-semibold text-ploy-text-primary [&_code]:font-mono [&_code]:text-[0.86em]" set:html={md(seg.title).replace(/^<p>|<\/p>\s*$/g, "")} />}
          <div class="[&_.prose]:max-w-none [&_.prose_p]:my-2 [&_.prose_p]:text-[1rem] [&_.prose_p]:leading-[1.65]">
            <Astro.self segments={seg.children} nested />
          </div>
        </aside>
      );
    }
    if (seg.type === "details") {
      return (
        <details class:list={["group my-8 rounded-[6px]", GLASS_SURFACE, COLUMN]} style={GLASS_BG}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[0.9375rem] font-medium text-ploy-text-primary [&::-webkit-details-marker]:hidden">
            <span class="[&_p]:m-0 [&_strong]:font-semibold" set:html={md(seg.summary)} />
            <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-ploy-text-secondary transition-transform group-open:rotate-180"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="border-t border-ploy-border-primary px-5 pb-2">
            <Astro.self segments={seg.children} nested />
          </div>
        </details>
      );
    }
    return null;
  })
}
