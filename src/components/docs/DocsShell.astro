---
/**
 * Every docs page, laid out like nnsight.net: the section's menu on the left,
 * the page in the middle, its table of contents on the right. Type, color and
 * blocks come from the blog, so docs and blog read as one site. Below lg the
 * menu and contents fold into two dropdowns above the page.
 */
import "katex/dist/katex.min.css";
import "./docs.css";
import Layout from "@/layouts/Layout.astro";
import { Container } from "@/components/design-system/ui/container";
import DocsNavTree from "./DocsNavTree.astro";
import { DOCS_NAV, type SectionKey } from "@/lib/docs-links";
import type { TocItem } from "./types";

interface Props {
  title: string;
  description?: string;
  path: string;
  section?: string;
  toc?: TocItem[];
  /** One full-width column, for pages that bring their own layout (status). */
  wide?: boolean;
}

const { title, description, path, section, toc = [], wide = false } = Astro.props;
const nav = section ? DOCS_NAV[section as SectionKey] : undefined;
const chevron = "M4 6l4 4 4-4";
---

<Layout title={`${title} - nnsight`} description={description} siteName="nnsight" type="article">
  <main id="main-content" tabindex="-1" class="blog-type">
    <Container>
      <div class:list={["grid pt-8 pb-24 md:pt-12", !wide && "lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-x-12 xl:grid-cols-[220px_minmax(0,1fr)_200px]"]}>
        <aside class:list={["hidden", !wide && "lg:block"]}>
          {
            nav && (
              <nav aria-label={`${nav.label} pages`} data-docs-sidebar class="sticky top-24 max-h-[calc(100vh-7.5rem)] overflow-y-auto pr-2 pb-8">
                <a
                  href={nav.path}
                  class:list={[
                    "mb-2 block text-[0.9375rem] font-semibold",
                    path === nav.path ? "text-ploy-accent-primary" : "text-ploy-text-primary hover:text-ploy-accent-primary",
                  ]}
                >
                  {nav.label}
                </a>
                <DocsNavTree links={nav.children ?? []} current={path} />
              </nav>
            )
          }
        </aside>

        <div class="min-w-0">
          <div class:list={["mx-auto w-full", !wide && "max-w-[46rem]"]}>
            {
              nav && (
                <details class="group mb-3 rounded-[6px] shadow-[inset_0_0_0_1px_var(--ploy-border-primary)] lg:hidden">
                  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[0.875rem] font-medium text-ploy-text-primary [&::-webkit-details-marker]:hidden">
                    {nav.label} menu
                    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 text-ploy-text-secondary transition-transform group-open:rotate-180">
                      <path d={chevron} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <div class="max-h-[60vh] overflow-y-auto border-t border-ploy-border-primary px-4 py-3">
                    <a href={nav.path} class="mb-1 block text-[0.9375rem] font-semibold text-ploy-text-primary">{nav.label}</a>
                    <DocsNavTree links={nav.children ?? []} current={path} />
                  </div>
                </details>
              )
            }
            {
              toc.length > 0 && (
                <details class="group mb-3 rounded-[6px] shadow-[inset_0_0_0_1px_var(--ploy-border-primary)] xl:hidden">
                  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[0.875rem] font-medium text-ploy-text-primary [&::-webkit-details-marker]:hidden">
                    Table of contents
                    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 text-ploy-text-secondary transition-transform group-open:rotate-180">
                      <path d={chevron} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <ul class="flex max-h-[60vh] flex-col gap-2 overflow-y-auto border-t border-ploy-border-primary px-4 py-4 text-[0.875rem]">
                    {toc.map((h) => (
                      <li class:list={[h.depth > 2 && "pl-4"]}>
                        <a href={`#${h.id}`} class="text-ploy-text-secondary hover:text-ploy-text-primary">{h.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )
            }
            <h1 class="mt-6 mb-6 font-heading text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] text-balance [overflow-wrap:anywhere] text-ploy-text-primary md:text-[2.5rem] lg:mt-0">
              {title}
            </h1>
            <div class="docs-body" data-pagefind-body>
              <slot />
            </div>
          </div>
        </div>

        <aside class:list={["hidden", !wide && "xl:block"]}>
          {
            toc.length > 0 && (
              <nav aria-labelledby="toc-heading" class="sticky top-24 max-h-[calc(100vh-7.5rem)] overflow-y-auto pb-8">
                <p id="toc-heading" class="text-[0.8125rem] font-medium text-ploy-text-primary">
                  Table of contents
                </p>
                <ul class="mt-3 flex flex-col gap-2 border-l border-ploy-border-primary text-[0.8125rem] leading-[1.45]">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.id}`}
                        data-toc-link={h.id}
                        class:list={[
                          "-ml-px block border-l border-transparent [overflow-wrap:anywhere] text-ploy-text-secondary transition-colors hover:border-ploy-text-primary hover:text-ploy-text-primary",
                          "data-[active]:border-ploy-accent-primary data-[active]:text-ploy-accent-primary",
                          h.depth <= 2 ? "pl-4" : "pl-7",
                        ]}
                      >
                        {h.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </aside>
      </div>
    </Container>
  </main>
</Layout>

<script>
  // Keep the current page in view inside a long section menu.
  const sidebar = document.querySelector<HTMLElement>("[data-docs-sidebar]");
  const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
  if (sidebar && current) {
    const top = current.offsetTop - sidebar.clientHeight / 3;
    if (top > 0) sidebar.scrollTop = top;
  }

  // Mark the section being read in the table of contents.
  const tocLinks = [...document.querySelectorAll<HTMLElement>("[data-toc-link]")];
  const headings = tocLinks
    .map((a) => document.getElementById(a.dataset.tocLink!))
    .filter((h): h is HTMLElement => Boolean(h));
  if (headings.length) {
    const mark = () => {
      let active = headings[0];
      for (const h of headings) if (h.getBoundingClientRect().top < 140) active = h;
      for (const a of tocLinks) {
        if (a.dataset.tocLink === active.id) a.dataset.active = "";
        else delete a.dataset.active;
      }
    };
    mark();
    window.addEventListener("scroll", mark, { passive: true });
  }

  // Notebook charts: load plotly (served from this site) once a chart is near.
  const charts = document.querySelectorAll<HTMLElement>(".doc-plotly[data-src]");
  if (charts.length) {
    let plotly: Promise<any> | undefined;
    const loadPlotly = () =>
      (plotly ??= new Promise((resolve, reject) => {
        const s = document.createElement("script");
        s.src = "/vendor/plotly-2.35.2.min.js";
        s.onload = () => resolve((window as any).Plotly);
        s.onerror = reject;
        document.head.appendChild(s);
      }));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          Promise.all([loadPlotly(), fetch(el.dataset.src!).then((r) => r.json())]).then(([Plotly, fig]) => {
            const layout = { ...fig.layout, autosize: true };
            delete layout.width;
            Plotly.newPlot(el, fig.data, layout, { ...fig.config, responsive: true, displaylogo: false });
          });
        }
      },
      { rootMargin: "400px 0px" },
    );
    charts.forEach((c) => io.observe(c));
  }
</script>
