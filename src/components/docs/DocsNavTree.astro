---
/**
 * One docs section's menu, in nnsight.net's order and wording. Folders open
 * like theirs; the page you're on is marked in the accent color.
 */
import type { NavLink } from "@/lib/docs-links";

interface Props {
  links: NavLink[];
  current: string;
  depth?: number;
}

const { links, current, depth = 0 } = Astro.props;
const linkClass = (active: boolean) => [
  "block py-1 text-[0.875rem] leading-[1.45] transition-colors",
  active ? "font-medium text-ploy-accent-primary" : "text-ploy-text-secondary hover:text-ploy-text-primary",
];
---

<ul class:list={["flex flex-col", depth > 0 && "ml-1 border-l border-ploy-border-primary pl-3"]}>
  {
    links.map((link) =>
      link.children?.length ? (
        <li>
          <details open>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
              {link.own ? (
                <a href={link.path} class:list={linkClass(link.path === current)} aria-current={link.path === current ? "page" : undefined}>
                  {link.label}
                </a>
              ) : (
                <span class="block py-1 text-[0.875rem] leading-[1.45] font-medium text-ploy-text-primary">{link.label}</span>
              )}
              <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5 shrink-0 text-ploy-text-secondary transition-transform [details[open]>summary>&]:rotate-180">
                <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <Astro.self links={link.children} current={current} depth={depth + 1} />
          </details>
        </li>
      ) : (
        <li>
          <a href={link.path} class:list={linkClass(link.path === current)} aria-current={link.path === current ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ),
    )
  }
</ul>
