---
/**
 * Renders a docs page body with the blog's own components and classes:
 * prose text, the dark code editor with copy button, frosted notes and
 * collapsible details, framed figures and charts. Notebook outputs get a
 * light mono panel on the same frosted surface. The copy buttons and charts
 * are wired up by the script in DocsShell.astro.
 */
import { BlogCodeLines } from "@/components/sections/blog/blog-code";
import { CODE_BG, CODE_FRAME, COLUMN, GLASS_BG, GLASS_SURFACE, wrapTables } from "@/components/sections/blog/blog-styles";
import { DOCS_PROSE } from "./docs-styles";
import type { Seg } from "./types";

interface Props {
  segments: Seg[];
  nested?: boolean;
}

const { segments, nested = false } = Astro.props;
---

{
  segments.map((seg) => {
    if (seg.type === "html") {
      return <div class:list={[DOCS_PROSE, nested && "prose-p:my-3"]} set:html={wrapTables(seg.html)} />;
    }
    if (seg.type === "code") {
      if (!seg.code.trim()) return null;
      return (
        <div class:list={[CODE_FRAME, COLUMN, "!my-6"]} style={CODE_BG}>
          <div class="flex h-10 items-center justify-end border-b border-white/[0.06] pr-1">
            <button
              type="button"
              data-copy={seg.code}
              title="Copy to clipboard"
              aria-label="Copy to clipboard"
              class="group/copy inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-[6px] text-white/55 transition-colors duration-200 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/60"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 group-data-[copied]/copy:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
              </svg>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="hidden size-4 group-data-[copied]/copy:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </button>
          </div>
          <BlogCodeLines code={seg.code} lang={seg.lang} />
        </div>
      );
    }
    if (seg.type === "output") {
      return (
        <pre
          class:list={["not-prose -mt-2 mb-6 max-h-[32rem] overflow-auto rounded-[6px] px-5 py-4 font-mono text-[0.8125rem] leading-[1.6] whitespace-pre text-ploy-text-secondary", GLASS_SURFACE, COLUMN]}
          style={GLASS_BG}
        >{seg.text}</pre>
      );
    }
    if (seg.type === "figure") {
      return (
        <figure class:list={["not-prose my-8", COLUMN]}>
          <div class:list={["overflow-hidden rounded-[6px] p-2.5 md:p-4", GLASS_SURFACE]} style={GLASS_BG}>
            <img src={seg.src} alt={seg.alt} loading="lazy" decoding="async" class="mx-auto h-auto max-w-full rounded-[6px] bg-white" />
          </div>
        </figure>
      );
    }
    if (seg.type === "plotly") {
      return (
        <figure class:list={["not-prose my-8", COLUMN]}>
          <div class:list={["overflow-hidden rounded-[6px] p-2.5 md:p-4", GLASS_SURFACE]} style={GLASS_BG}>
            <div class="doc-plotly w-full rounded-[6px] bg-white" data-src={seg.src} style={`height:${seg.height}px`} />
          </div>
        </figure>
      );
    }
    if (seg.type === "note") {
      return (
        <aside class:list={["my-8 rounded-[6px] px-5 py-4 md:px-6 md:py-5", GLASS_SURFACE, COLUMN]} style={GLASS_BG}>
          {seg.title && (
            <p class="text-[0.9375rem] font-semibold text-ploy-text-primary [&_code]:font-mono [&_code]:text-[0.86em]" set:html={seg.title} />
          )}
          <div class="[&_.prose]:max-w-none [&_.prose_p]:my-2 [&_.prose_p]:text-[1rem] [&_.prose_p]:leading-[1.65]">
            <Astro.self segments={seg.children} nested />
          </div>
        </aside>
      );
    }
    if (seg.type === "details") {
      return (
        <details class:list={["group my-8 rounded-[6px]", GLASS_SURFACE, COLUMN]} style={GLASS_BG}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[0.9375rem] font-medium text-ploy-text-primary [&::-webkit-details-marker]:hidden">
            <span class="[&_p]:m-0 [&_strong]:font-semibold [&_b]:font-semibold [&_code]:font-mono [&_code]:text-[0.86em]" set:html={seg.summary} />
            <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-ploy-text-secondary transition-transform group-open:rotate-180">
              <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="border-t border-ploy-border-primary px-5 pb-2">
            <Astro.self segments={seg.children} nested />
          </div>
        </details>
      );
    }
    return null;
  })
}
