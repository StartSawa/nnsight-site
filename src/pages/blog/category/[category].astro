---
import Layout from "../../../layouts/Layout.astro";
import { BlogIndex } from "../../../components/sections/blog/blog-index";
import { CATEGORIES, categorySlug, toListPost } from "../../../components/sections/blog/types";
import { blogDb, listPosts, setBlogCacheHeaders } from "../../../lib/blog-db";

export async function getStaticPaths() {
  const { posts } = await listPosts();
  const used = [...new Set(posts.map((p) => p.category).filter(Boolean))];
  return used.map((c) => ({ params: { category: categorySlug(c) } }));
}

export const ployPreviewParams = { category: "guide" };

const { category: param } = Astro.params;
const { posts, transient } = await listPosts();
if (transient) return blogDb.unavailable();

const categories = [...new Set([...CATEGORIES, ...posts.map((p) => p.category).filter(Boolean)])].sort();
const category = categories.find((c) => categorySlug(c) === param);
const inCategory = category ? posts.filter((p) => p.category === category) : [];
if (!category || inCategory.length === 0) return new Response(null, { status: 404 });
setBlogCacheHeaders(Astro.response.headers);
---

<Layout
  title={`${category} - nnsight`}
  description={`${category} posts from the NNsight blog: ${inCategory.map((p) => p.title).join("; ")}.`}
>
  <main id="main-content" tabindex={-1} class="blog-type">
    <BlogIndex heading={category} posts={inCategory.map(toListPost)} categories={categories} activeCategory={category} mode="category" />
  </main>
</Layout>
