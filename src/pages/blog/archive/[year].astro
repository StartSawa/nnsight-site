---
import Layout from "../../../layouts/Layout.astro";
import { BlogIndex } from "../../../components/sections/blog/blog-index";
import { CATEGORIES, toListPost } from "../../../components/sections/blog/types";
import { blogDb, listPosts, setBlogCacheHeaders } from "../../../lib/blog-db";

export async function getStaticPaths() {
  const { posts } = await listPosts();
  return [...new Set(posts.map((p) => p.pubDate.slice(0, 4)))].map((year) => ({ params: { year } }));
}

export const ployPreviewParams = { year: "2026" };

const { year } = Astro.params;
const { posts, transient } = await listPosts();
if (transient) return blogDb.unavailable();

const inYear = posts.filter((p) => p.pubDate.startsWith(`${year}-`));
if (!/^\d{4}$/.test(year ?? "") || inYear.length === 0) return new Response(null, { status: 404 });
setBlogCacheHeaders(Astro.response.headers);
const categories = [...new Set([...CATEGORIES, ...posts.map((p) => p.category).filter(Boolean)])].sort();
---

<Layout
  title={`${year} - nnsight`}
  description={`NNsight blog posts from ${year}: ${inYear.map((p) => p.title).join("; ")}.`}
>
  <main id="main-content" tabindex={-1} class="blog-type">
    <BlogIndex heading={year!} posts={inYear.map(toListPost)} categories={categories} activeCategory={null} mode="archive" />
  </main>
</Layout>
